# All-in-one image — build from monorepo root: docker build -f docker/Dockerfile.all-in-one .
# PostgreSQL + Redis + Meilisearch + API + nginx (UI static assets).

FROM rust:1.90-bookworm AS builder-rust

WORKDIR /app

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY server/Cargo.toml ./

RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm -rf src

COPY server/src ./src
COPY server/migrations ./migrations
COPY server/config ./config
COPY server/data ./data

RUN touch src/main.rs && \
    cargo build --release

FROM node:20-alpine AS builder-ui

RUN npm install -g pnpm@9

WORKDIR /app/ui

COPY ui/package.json ui/pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY ui/ ./

RUN pnpm run build

FROM postgres:16

ARG MEILISEARCH_VERSION=1.12.0

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    redis-server \
    nginx \
    supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://github.com/meilisearch/meilisearch/releases/download/v${MEILISEARCH_VERSION}/meilisearch-linux-amd64" \
        -o /usr/local/bin/meilisearch \
    && chmod +x /usr/local/bin/meilisearch

WORKDIR /app

COPY --from=builder-rust /app/target/release/elidune-server /app/elidune-server
COPY --from=builder-rust /app/migrations /app/migrations
COPY --from=builder-rust /app/config /app/config
COPY --from=builder-rust /app/data /app/data

COPY --from=builder-ui /app/ui/dist /usr/share/nginx/html

RUN chmod +x /app/elidune-server

RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-available/default
COPY docker/nginx-all-in-one.conf /etc/nginx/conf.d/default.conf

COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/wait-and-start-server.sh /app/wait-and-start-server.sh
RUN chmod +x /app/wait-and-start-server.sh

RUN mkdir -p /meili_data /var/log/supervisor

EXPOSE 5432 6379 7700 8080 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
