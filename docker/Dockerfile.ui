# UI image — build from monorepo root: docker build -f docker/Dockerfile.ui .
# Serves the SPA via nginx and reverse-proxies /api to the API container (service name: elidnune-server).

FROM node:20-alpine AS builder

RUN npm install -g pnpm@9

WORKDIR /app

COPY ui/package.json ui/pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY ui/ ./
# ui/src/data imports ../../../server/data/countryTimezones.json. With ui/
# copied to /app, that path is /server/data/.
RUN mkdir -p /server/data
COPY server/data/countryTimezones.json /server/data/countryTimezones.json

RUN pnpm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx-ui.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
